# Use this for running WITHOUT Docker (XAMPP MySQL + local MongoDB).
# Copy to .env:  (Windows) copy .env.local.example .env   (Mac/Linux) cp .env.local.example .env

# ---- Required: get a free key at https://console.groq.com/keys ----
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Auth ----
JWT_SECRET=please-change-this-secret
JWT_EXPIRE_MINUTES=1440

# ---- MySQL (XAMPP defaults: user "root", empty password) ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=pregunta

# ---- MongoDB (local install on default port) ----
MONGO_URL=mongodb://localhost:27017
MONGO_DB=pregunta

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173
